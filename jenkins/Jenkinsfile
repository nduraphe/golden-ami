pipeline {
    agent any

    parameters {
        string(name: 'INSTANCE_TYPE', defaultValue: 't3.micro', description: 'EC2 Instance Type')
        string(name: 'BASE_AMI', defaultValue: 'ami-0222331ecd1b7e353', description: 'Base Windows AMI ID')
        string(name: 'SHARE_ACCOUNTS', defaultValue: '284495578504', description: 'Comma-separated AWS Account IDs to share this AMI with')
        string(name: 'S3_BUCKET', defaultValue: 'golden-ami-softwares-nagesh', description: 'S3 bucket containing software installers')
        string(name: 'INSTALL_SCRIPT_NAME', defaultValue: 'install_vscode.ps1', description: 'Script name under packer/scripts/ to run inside AMI build')
    }

    environment {
        AWS_DEFAULT_REGION = 'us-west-2'
        PACKER_LOG = '1'
    }

    options {
        ansiColor('xterm')
        timestamps()
    }

    stages {

        stage('Checkout Repository') {
            steps {
                cleanWs()
                checkout scm
                powershell 'Get-ChildItem -Recurse'
            }
        }

        stage('Validate Parameters & Install Script') {
            steps {
                script {
                    if (!params.BASE_AMI.startsWith('ami-')) {
                        error "❌ Invalid BASE_AMI: ${params.BASE_AMI}"
                    }

                    def validInstanceTypes = ['t3.micro','t3.small','t3.medium','t3.large']
                    if (!validInstanceTypes.contains(params.INSTANCE_TYPE)) {
                        error "❌ Invalid INSTANCE_TYPE: ${params.INSTANCE_TYPE}. Choose from ${validInstanceTypes}"
                    }

                    def scriptPath = "packer/scripts/${params.INSTALL_SCRIPT_NAME}"
                    echo "📁 Checking required install script: ${scriptPath}"
                    if (!fileExists(scriptPath)) {
                        error "❌ Install script not found: ${scriptPath}"
                    } else {
                        echo "✅ Found install script: ${scriptPath}"
                        powershell "Get-Content -Path '${scriptPath}' -TotalCount 10"
                    }
                }
            }
        }

        stage('Build Golden Windows AMI with Packer') {
            steps {
                script {
                    echo "🚀 Starting Packer build for Windows Golden AMI..."
                    withAWS(credentials: 'AWS_Creds', region: "${AWS_DEFAULT_REGION}") {
                        retry(2) {
                            def amiName = "Golden_AMI_Windows_${new Date().format('yyyyMMdd_HHmmss')}"
                            def packerCmd = """
                                packer build `
                                    -var 'aws_region=${AWS_DEFAULT_REGION}' `
                                    -var 'instance_type=${params.INSTANCE_TYPE}' `
                                    -var 'base_ami=${params.BASE_AMI}' `
                                    -var 's3_software_bucket=${params.S3_BUCKET}' `
                                    -var 'install_script=packer/scripts/${params.INSTALL_SCRIPT_NAME}' `
                                    -var 'ami_name=${amiName}' `
                                    -machine-readable `
                                    | Tee-Object -FilePath packer_build.log
                            """
                            powershell packerCmd
                        }
                    }
                }
            }
        }

        stage('Extract AMI ID') {
            steps {
                script {
                    echo "🧾 Extracting AMI ID from Packer output..."
                    def amiId = powershell(
                        script: """
                            \$line = Select-String -Path 'packer_build.log' -Pattern 'artifact,0,id' | Select-Object -Last 1
                            if (\$line) {
                                \$line.Line.Split(',')[5]
                            }
                        """,
                        returnStdout: true
                    ).trim()

                    if (!amiId) {
                        error "❌ AMI creation failed or AMI ID not found in Packer output."
                    }

                    env.AMI_ID = amiId
                    echo "✅ AMI created successfully: ${env.AMI_ID}"
                    writeFile file: 'ami_id.txt', text: env.AMI_ID
                }
            }
        }

        stage('Share AMI with other AWS accounts') {
            when {
                expression { return params.SHARE_ACCOUNTS?.trim() && env.AMI_ID }
            }
            steps {
                script {
                    withAWS(credentials: 'AWS_Creds', region: "${AWS_DEFAULT_REGION}") {
                        params.SHARE_ACCOUNTS.split(',').each { acc ->
                            def trimmed = acc.trim()
                            if (trimmed) {
                                echo "🔗 Sharing AMI ${env.AMI_ID} with account: ${trimmed}"
                                powershell """
                                    aws ec2 modify-image-attribute `
                                        --image-id ${env.AMI_ID} `
                                        --launch-permission "Add=[{UserId=${trimmed}}]" `
                                        --region ${AWS_DEFAULT_REGION}
                                """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'packer_build.log, ami_id.txt', onlyIfSuccessful: false
            cleanWs()
        }
        success {
            echo "🎉 Golden Windows AMI created successfully! AMI ID: ${env.AMI_ID}"
        }
        failure {
            echo "❌ Golden AMI build failed. Check packer_build.log for details."
        }
    }
}