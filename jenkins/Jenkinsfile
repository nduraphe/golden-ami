pipeline {
    agent any

    parameters {
        string(name: 'AWS_ACCOUNT_ID', description: 'Target AWS Account ID')
        string(name: 'INSTANCE_TYPE', defaultValue: 't3.medium', description: 'EC2 Instance Type')
        string(name: 'BASE_AMI', description: 'Base Windows AMI ID')
        string(name: 'SHARE_ACCOUNTS', description: 'Comma-separated AWS Account IDs to share this AMI with')
        string(name: 'S3_BUCKET', defaultValue: 'golden-ami-softwares-nagesh', description: 'S3 bucket containing software installers')
        file(name: 'INSTALL_SCRIPT', description: 'Upload your PowerShell install script (.ps1)')
    }

    environment {
        AWS_DEFAULT_REGION = 'us-west-2'
        PACKER_LOG = '1'
    }

    options {
        ansiColor('xterm')
        timestamps()
    }

    stages {
        stage('Prepare Workspace') {
            steps {
                cleanWs()
                script {
                    echo "Creating required directories..."
                    sh 'mkdir -p packer/scripts'
                    echo "Saving uploaded install script..."

                    // The uploaded file is placed in the workspace with the same name as the parameter
                    // Copy or rename it for Packer usage
                    sh "cp '${params.INSTALL_SCRIPT}' packer/scripts/install_user.ps1"
                }
            }
        }

        stage('Validate Install Script') {
            steps {
                script {
                    echo "Verifying install script..."
                    sh 'ls -l packer/scripts/'
                    sh 'head -n 5 packer/scripts/install_user.ps1 || true'
                }
            }
        }

        stage('Build Golden Windows AMI with Packer') {
            steps {
                script {
                    echo "Starting Packer build process..."
                    withAWS(credentials: 'd7da5a8a-1ac3-4fe3-b819-9da2b3469db7', region: "${AWS_DEFAULT_REGION}") {
                        sh """
                        packer build \
                          -var 'aws_region=${AWS_DEFAULT_REGION}' \
                          -var 'instance_type=${params.INSTANCE_TYPE}' \
                          -var 'base_ami=${params.BASE_AMI}' \
                          -var 's3_software_bucket=${params.S3_BUCKET}' \
                          -var 'install_script=packer/scripts/install_user.ps1' \
                          -machine-readable packer/golden_ami_template.json | tee packer_build.log
                        """
                    }
                }
            }
        }

        stage('Extract AMI ID') {
            steps {
                script {
                    echo "Extracting AMI ID from Packer output..."
                    sh "grep 'artifact,0,id' packer_build.log | tail -1 | cut -d, -f6 | cut -d: -f2 > ami_id.txt"
                    env.AMI_ID = readFile('ami_id.txt').trim()
                    echo "Generated AMI ID: ${env.AMI_ID}"
                }
            }
        }

        stage('Share AMI with other AWS accounts') {
            when {
                expression { return params.SHARE_ACCOUNTS?.trim() }
            }
            steps {
                script {
                    withAWS(credentials: 'd7da5a8a-1ac3-4fe3-b819-9da2b3469db7', region: "${AWS_DEFAULT_REGION}") {
                        def accounts = params.SHARE_ACCOUNTS.split(',')
                        for (acc in accounts) {
                            def trimmed = acc.trim()
                            echo "Sharing AMI ${env.AMI_ID} with account: ${trimmed}"
                            sh """
                            aws ec2 modify-image-attribute \
                                --image-id ${env.AMI_ID} \
                                --launch-permission Add=[{UserId=${trimmed}}]
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'packer_build.log, ami_id.txt', onlyIfSuccessful: false
            cleanWs()
        }
        success {
            echo "Golden AMI created successfully! ✅ AMI ID: ${env.AMI_ID}"
        }
        failure {
            echo "Golden AMI build failed ❌ Check logs for details."
        }
    }
}
