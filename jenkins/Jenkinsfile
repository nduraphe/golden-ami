pipeline {
    agent any

    parameters {
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '284495578504', description: 'Target AWS Account ID')
        string(name: 'INSTANCE_TYPE', defaultValue: 't3.micro', description: 'EC2 Instance Type')
        string(name: 'BASE_AMI', defaultValue: 'ami-043cc489b5239c3de', description: 'Base Windows AMI ID')
        string(name: 'SHARE_ACCOUNTS', defaultValue: '284495578504', description: 'Comma-separated AWS Account IDs to share this AMI with')
        string(name: 'S3_BUCKET', defaultValue: 'golden-ami-softwares-nagesh', description: 'S3 bucket containing software installers')
        file(name: 'INSTALL_SCRIPT', description: 'Upload your PowerShell install script (.ps1)')
    }

    environment {
        AWS_DEFAULT_REGION = 'us-west-2'
        PACKER_LOG = '1'
    }

    options {
        ansiColor('xterm')
        timestamps()
    }

    stages {
        stage('Prepare Workspace') {
            steps {
                cleanWs()
                script {
                    echo "📁 Creating required directories..."
                    sh 'mkdir -p packer/scripts'

                    echo "📄 Copying uploaded PowerShell install script..."
                    // Correct way to access uploaded file
                    sh 'cp "$INSTALL_SCRIPT" packer/scripts/install_user.ps1'

                    echo "✅ Install script saved to packer/scripts/install_user.ps1"
                }
            }
        }

        stage('Validate Install Script') {
            steps {
                script {
                    echo "🔍 Validating uploaded install script..."
                    sh 'ls -lh packer/scripts/'
                    sh 'head -n 10 packer/scripts/install_user.ps1 || true'
                }
            }
        }

        stage('Build Golden Windows AMI with Packer') {
            steps {
                script {
                    echo "🚀 Starting Packer build for Windows Golden AMI..."
                    withAWS(credentials: 'd7da5a8a-1ac3-4fe3-b819-9da2b3469db7', region: "${AWS_DEFAULT_REGION}") {
                        sh """
                            packer init packer/golden_ami_template.json
                            packer build \
                              -var 'aws_region=${AWS_DEFAULT_REGION}' \
                              -var 'instance_type=${params.INSTANCE_TYPE}' \
                              -var 'base_ami=${params.BASE_AMI}' \
                              -var 'aws_account_id=${params.AWS_ACCOUNT_ID}' \
                              -var 's3_software_bucket=${params.S3_BUCKET}' \
                              -var 'install_script=packer/scripts/install_user.ps1' \
                              -machine-readable packer/golden_ami_template.json | tee packer_build.log
                        """
                    }
                }
            }
        }

        stage('Extract AMI ID') {
            steps {
                script {
                    echo "🧾 Extracting AMI ID from Packer output..."
                    sh "grep 'artifact,0,id' packer_build.log | tail -1 | cut -d, -f6 | cut -d: -f2 > ami_id.txt"
                    env.AMI_ID = readFile('ami_id.txt').trim()
                    echo "✅ AMI created successfully: ${env.AMI_ID}"
                }
            }
        }

        stage('Share AMI with other AWS accounts') {
            when {
                expression { return params.SHARE_ACCOUNTS?.trim() }
            }
            steps {
                script {
                    withAWS(credentials: 'd7da5a8a-1ac3-4fe3-b819-9da2b3469db7', region: "${AWS_DEFAULT_REGION}") {
                        def accounts = params.SHARE_ACCOUNTS.split(',')
                        for (acc in accounts) {
                            def trimmed = acc.trim()
                            echo "🔗 Sharing AMI ${env.AMI_ID} with account: ${trimmed}"
                            sh """
                                aws ec2 modify-image-attribute \
                                    --image-id ${env.AMI_ID} \
                                    --launch-permission "Add=[{UserId=${trimmed}}]" \
                                    --region ${AWS_DEFAULT_REGION}
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'packer_build.log, ami_id.txt', onlyIfSuccessful: false
            cleanWs()
        }
        success {
            echo "🎉 Golden Windows AMI created successfully! AMI ID: ${env.AMI_ID}"
        }
        failure {
            echo "❌ Golden AMI build failed. Check packer_build.log for details."
        }
    }
}
