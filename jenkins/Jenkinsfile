pipeline {
    agent any

    parameters {
        choice(
            name: 'BASE_AMI_SELECTION',
            choices: '''Windows_Server_2025_Full
Windows_Server_2025_Core
Windows_Server_2022_Full
Windows_Server_2022_Core
Windows_Server_2019_Full
Windows_Server_2019_Core''',
            description: 'Select the base Windows AMI version'
        )
        string(name: 'INSTANCE_TYPE', defaultValue: 't3.micro', description: 'EC2 Instance Type')
        string(name: 'SHARE_ACCOUNTS', defaultValue: '284495578504', description: 'Comma-separated AWS Account IDs to share this AMI with')
        string(name: 'S3_BUCKET', defaultValue: 'golden-ami-softwares-nagesh', description: 'S3 bucket containing software installers')
        string(name: 'INSTALL_SCRIPT_NAME', defaultValue: 'install_software.ps1', description: 'Script name under packer/scripts/ to run inside AMI build')
    }

    environment {
        AWS_DEFAULT_REGION = 'us-west-2'
        PACKER_LOG = '1'
    }

    options {
        ansiColor('xterm')
        timestamps()
    }

    stages {

        stage('Checkout Repository') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Resolve Latest Base AMI') {
            steps {
                script {
                    def amiMap = [
                        'Windows_Server_2025_Full' : 'Windows_Server-2025-English-Full-Base',
                        'Windows_Server_2025_Core' : 'Windows_Server-2025-English-Core-Base',
                        'Windows_Server_2022_Full' : 'Windows_Server-2022-English-Full-Base',
                        'Windows_Server_2022_Core' : 'Windows_Server-2022-English-Core-Base',
                        'Windows_Server_2019_Full' : 'Windows_Server-2019-English-Full-Base',
                        'Windows_Server_2019_Core' : 'Windows_Server-2019-English-Core-Base'
                    ]

                    def searchName = amiMap[params.BASE_AMI_SELECTION]
                    echo "🔍 Searching latest AMI for: ${params.BASE_AMI_SELECTION}"

                    env.BASE_AMI = sh(
                        script: "aws ec2 describe-images --owners 801119661308 --filters Name=name,Values=${searchName}* Name=state,Values=available --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' --output text",
                        returnStdout: true
                    ).trim()

                    if (!env.BASE_AMI) {
                        error "❌ Could not find latest AMI for ${params.BASE_AMI_SELECTION}"
                    }
                    echo "✅ Latest AMI resolved: ${env.BASE_AMI}"
                }
            }
        }

        stage('Validate Parameters & Install Script') {
            steps {
                script {
                    if (!env.BASE_AMI.startsWith('ami-')) {
                        error "❌ Invalid BASE_AMI: ${env.BASE_AMI}"
                    }

                    def validInstanceTypes = ['t3.micro','t3.small','t3.medium','t3.large','m5.large']
                    if (!validInstanceTypes.contains(params.INSTANCE_TYPE)) {
                        error "❌ Invalid INSTANCE_TYPE: ${params.INSTANCE_TYPE}. Choose from ${validInstanceTypes}"
                    }

                    def scriptPath = "packer/scripts/${params.INSTALL_SCRIPT_NAME}"
                    echo "📁 Checking required install script: ${scriptPath}"
                    if (!fileExists(scriptPath)) {
                        error "❌ Install script not found: ${scriptPath}"
                    } else {
                        echo "✅ Found install script: ${scriptPath}"
                    }
                }
            }
        }

        stage('Build Golden Windows AMI with Packer') {
            steps {
                script {
                    def amiName = "Golden_AMI_Windows_${new Date().format('yyyyMMdd_HHmmss')}"
                    echo "🚀 Starting Packer build for Windows Golden AMI: ${amiName}"
                    sh """
                        packer build -var "aws_region=${AWS_DEFAULT_REGION}" -var "instance_type=${params.INSTANCE_TYPE}" -var "base_ami=${env.BASE_AMI}" -var "s3_software_bucket=${params.S3_BUCKET}" -var "install_script=packer/scripts/${params.INSTALL_SCRIPT_NAME}" -var "ami_name=${amiName}" -machine-readable packer/golden_ami_template.pkr.hcl | tee packer_build.log
                    """
                }
            }
        }

        stage('Extract AMI ID') {
            steps {
                script {
                    env.AMI_ID = sh(
                        script: "awk -F, '/artifact,0,id/ {ami=\$6} END {print ami}' packer_build.log",
                        returnStdout: true
                    ).trim()

                    if (!env.AMI_ID) {
                        error "❌ AMI creation failed or AMI ID not found in Packer output."
                    }
                    echo "✅ AMI created successfully: ${env.AMI_ID}"
                    writeFile file: 'ami_id.txt', text: env.AMI_ID
                }
            }
        }

        stage('Share AMI with other AWS accounts') {
            when {
                expression { return params.SHARE_ACCOUNTS?.trim() && env.AMI_ID }
            }
            steps {
                script {
                    params.SHARE_ACCOUNTS.split(',').each { acc ->
                        def trimmed = acc.trim()
                        if (trimmed) {
                            echo "🔗 Sharing AMI ${env.AMI_ID} with account: ${trimmed}"
                            sh "aws ec2 modify-image-attribute --image-id ${env.AMI_ID} --launch-permission Add=[{UserId=${trimmed}}] --region ${AWS_DEFAULT_REGION}"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'packer_build.log, ami_id.txt', onlyIfSuccessful: false
            cleanWs()
        }
        success {
            echo "🎉 Golden Windows AMI created successfully! AMI ID: ${env.AMI_ID}"
        }
        failure {
            echo "❌ Golden AMI build failed. Check packer_build.log for details."
        }
    }
}
